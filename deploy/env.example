# /etc/english-practice/env —— systemd EnvironmentFile，权限 0640 root:englishapp
#
# 复制本文件到 /etc/english-practice/env，填好下面的值，然后：
#   sudo chown root:englishapp /etc/english-practice/env
#   sudo chmod 640 /etc/english-practice/env

# ------------------------------------------------------------------ 必填项

# Flask 的 SECRET_KEY（用于签名 session cookie）。生成方法：
#   python -c "import os; print(os.urandom(32).hex())"
# 生产环境务必用真随机值，不要用默认值。
SECRET_KEY={{GENERATE_A_RANDOM_64_CHAR_HEX_STRING}}

# 调试模式：生产环境必须 false
FLASK_DEBUG=false

# ------------------------------------------------------------------ 可选项（有默认值）

# 数据库与录音目录（相对路径按项目根算，即 app.py 所在目录）
#DATABASE_PATH=data/app.db
#RECORDING_DIR=data/recordings

# ------------------------------------------------------------------ 运行模式
# server = 要登录，成绩与朗读录音都写进上面那两个路径（默认，班级共用的正确选择）。
# local  = 不登录、也没有注册口，成绩与录音只存在**每台设备自己的浏览器**（IndexedDB）里，
#          服务器一个字节都不写；老师看不到进度，换设备记录不会跟过去。
#          只在「机房公用一台机器、不想给每人建账号」或「入站还没放行、先用能跑的机器把课开了」时用。
#
# 两种模式都要数据库：词库与近似音题库是出题的数据源，local 模式只是不往里写。
# 所以 scripts/init_db.py 这一步在 local 模式下同样不能省。
# 切到 local 之前先想清楚备份责任归谁：浏览器清数据、换浏览器、无痕窗口都会把一学期的
# 朗读记录清空，而服务器上没有第二份。详见 docs/deployment.md 第 8 节。
# 这个值和 REGISTER_MODE 一样是启动时读一次，改完要 systemctl restart 才生效。
# 值写错（LOCAL / LocalMode 等）不会静变成 local：会退回 server 并往 journal 里打一行中文警告。
APP_MODE=server

# ------------------------------------------------------------------ 密码哈希
# 这两个数直接决定「全班同一秒点登录」会不会把这台 1 核机拖死，改之前看
# docs/deployment.md 第 4 节「内存与并发调优」，以及 scripts/kdf_bench.py 的实测表。
#
# 推荐值（1 核 / 764MB 机器）：
#   scrypt:16384:8:1  校验 72ms、+18MB、13.8 次/s（端到端登录实测 12.3 次/s）
#
# werkzeug 默认值（更慢但更安全）：
#   scrypt:32768:8:1  校验 176ms、+34MB、5.7 次/s
#
# 老哈希不需要重置：验得过就能登，登的时候顺手按这里的参数改写。
# 代价是「改参数那天第一次登录」要多算一遍（176 + 72 ≈ 245ms），
# 所以真要换参数挑课后换，别在上课铃响前 1 分钟改。
PASSWORD_HASH_METHOD=scrypt:16384:8:1

# 同时算密码的并发上限，**每个 worker 进程各限各的**：整机上限 = workers × 这个数。
# 单核本来也是串行，排队不亏；限住是为了 scrypt 的峰值内存不超过 systemd 那两道闸门。
MAX_CONCURRENT_HASHES=2
HASH_QUEUE_TIMEOUT=20

# 应用侧自己把上传体积（MB），不再只靠 nginx 的 client_max_body_size 20m。
# 和 nginx 那个值保持一致；真要放宽得两头一起改，只改一边的话另一边的 413 长得完全不一样。
MAX_UPLOAD_MB=20

# 登录 cookie 只走 https。生产全站 https（80 端口只做 301 跳转），必须 true；
# 不开的话学生手敲 http:// 时 cookie 会先明文发出去一次。
# 只有在没有证书、直接用 http 访问的环境里才改成 false（否则登录后 cookie 存不下来）。
SESSION_COOKIE_SECURE=true

# 注册闸门：invite = 必须填邀请码（services/registration.py，码存在库里不在配置里）。
# open = 谁都能注册（只该出现在开发机上）；closed = 整个注册口关掉。
# 改这一行要重启才生效；发码 / 换码 / 吊销都不用重启。
REGISTER_MODE=invite
